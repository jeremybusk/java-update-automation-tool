{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/repositories.schema.json",
  "title": "Java repository portfolio",
  "type": "object",
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo_name", "source", "application_id", "application_group_id"],
        "properties": {
          "repo_name": {"type": "string", "minLength": 1},
          "repo_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "application_id": {"type": "string", "minLength": 1},
          "application_group_id": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
